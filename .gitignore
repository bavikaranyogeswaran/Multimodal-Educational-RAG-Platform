# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/build/
.vite/
.eslintcache
*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/.playwright/

