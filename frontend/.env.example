# =============================================================================
# Frontend configuration
# =============================================================================
# Copy to .env.local and fill in. Only VITE_-prefixed variables reach the browser.
#
# Never place a service role key here. Anything in this file is shipped to the
# client and is public by definition.
# =============================================================================

# Supabase — browser-side authentication.
# The anon key is safe to expose: row-level security is what protects the data,
# not the secrecy of this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API. Left empty in development so requests stay origin-relative and are
# proxied by Vite to the FastAPI process (see vite.config.ts).
VITE_API_BASE_URL=
