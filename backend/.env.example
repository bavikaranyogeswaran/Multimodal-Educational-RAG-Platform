# =============================================================================
# Multimodal Educational Tutor RAG — backend configuration
# =============================================================================
# Copy to .env and fill in the secrets. .env is gitignored; this file is not.
#
# Every value here has a working default in app/configuration/settings.py except
# the credentials, which are blank and must be supplied.
#
# Tuning constants live in configuration rather than in code because they have to
# be calibrated against evaluation data later, which is impossible if they are
# scattered through the codebase.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENVIRONMENT=local                  # local | staging | production
APP_API_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_GENERATION_POLICY_VERSION=1        # bump when generation or validation rules change

# -----------------------------------------------------------------------------
# Supabase — authentication
# -----------------------------------------------------------------------------
# Project settings -> API. The service role key bypasses row-level security:
# server-side only, never sent to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=                     # usually ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=600

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Supabase -> Connect -> Session pooler. The pooler host resolves on IPv4; the
# direct db.<ref>.supabase.co host is IPv6-only and unreachable on many networks.
# Session mode (5432) keeps prepared statements, which migrations rely on;
# transaction mode (6543) does not.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Percent-encode the password exactly once: $ -> %24, & -> %26, * -> %2A.
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
DATABASE_ECHO_SQL=false

# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2
# -----------------------------------------------------------------------------
STORAGE_ACCOUNT_ID=
STORAGE_BUCKET=tutor-rag
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

# A signed URL is the only storage-layer boundary, so its lifetime is capped at
# one hour. Values outside 60..3600 are rejected at startup, not silently accepted.
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Page renders feed OCR and are regenerable from the original, so they expire.
# Table and figure crops are permanent — they are re-sent to the multimodal model
# on every visual question.
STORAGE_PAGE_RENDER_PREFIX=cache/renders
STORAGE_PAGE_RENDER_TTL_SECONDS=604800
STORAGE_PAGE_RENDER_DPI=200

STORAGE_MAX_UPLOAD_BYTES=209715200     # 200 MB
STORAGE_MAX_UPLOAD_PAGES=1500

# -----------------------------------------------------------------------------
# Model gateway
# -----------------------------------------------------------------------------
MODEL_OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_OPENAI_COMPATIBLE_BASE_URL=      # vLLM or llama.cpp server, if used
MODEL_OPENAI_COMPATIBLE_API_KEY=

# Internal model keys. Application code names these, never a provider model
# string — provider names exist only here.
MODEL_DEFAULT_TEXT_MODEL=gemma3:4b
MODEL_DEFAULT_VISION_MODEL=gemma3:4b
MODEL_QUERY_REWRITE_MODEL=gemma3:4b
MODEL_FAITHFULNESS_MODEL=gemma3:4b

# The system never silently falls back from a local model to an external provider.
# Leave false unless an external provider is intended.
MODEL_ALLOW_EXTERNAL_PROVIDERS=false

MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=1                    # one retry, then an approved fallback
MODEL_WARM_MODELS_ON_STARTUP=true

# Backpressure rather than unbounded queueing. Kept low because the GPU is 6 GB and
# a second concurrent generation would not fit alongside the retrieval models.
MODEL_MAX_CONCURRENT_GENERATIONS=2
MODEL_MAX_CONCURRENT_GENERATIONS_PER_USER=1
MODEL_GENERATION_QUEUE_SIZE=16

# Task-specific output caps
MODEL_MAX_OUTPUT_TOKENS_ANSWER=1024
MODEL_MAX_OUTPUT_TOKENS_REWRITE=128
MODEL_MAX_OUTPUT_TOKENS_EXPANSION=256
MODEL_MAX_OUTPUT_TOKENS_SUMMARY=2048

# -----------------------------------------------------------------------------
# Embeddings and reranking
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64

# Bumping this forces a reindex rather than an in-place swap: dimensions and
# similarity distributions differ between embedding models.
EMBEDDING_INDEX_VERSION=1

RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_DEVICE=cuda
RERANKER_BATCH_SIZE=32
RERANKER_MAX_CANDIDATES=40             # 30-50 depending on hardware

# -----------------------------------------------------------------------------
# OCR — on CPU, so the 6 GB GPU stays available for inference
# -----------------------------------------------------------------------------
OCR_DEVICE=cpu
OCR_LANGUAGE=en

# The heavier vision-language fallback fires only on difficult pages. Exceeding the
# page fraction on a representative document means the classifier is miscalibrated,
# not that the document is unusual.
OCR_VL_FALLBACK_ENABLED=true
OCR_VL_CONFIDENCE_THRESHOLD=0.65
OCR_VL_MAX_PAGE_FRACTION=0.20
OCR_NATIVE_TEXT_COVERAGE_THRESHOLD=0.10

# -----------------------------------------------------------------------------
# Chunking
# -----------------------------------------------------------------------------
CHUNKING_CHILD_TARGET_TOKENS=400
CHUNKING_CHILD_MAX_TOKENS=700
CHUNKING_CHILD_OVERLAP_TOKENS=70
CHUNKING_PARENT_TARGET_TOKENS=1200
CHUNKING_PARENT_MAX_TOKENS=1500

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# Two or three variants, four queries total, at temperature zero so expansion is
# reproducible.
RETRIEVAL_EXPANSION_VARIANTS=3
RETRIEVAL_EXPANSION_MAX_QUERIES=4
RETRIEVAL_EXPANSION_TEMPERATURE=0.0

# The first stage optimises recall; precision comes from reranking afterwards.
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_KEYWORD_TOP_K=30
RETRIEVAL_CANDIDATE_POOL_SIZE=50

RETRIEVAL_RRF_K=60                     # published starting value, not derived for this corpus

# One hop. Deeper traversal expands combinatorially and mostly surfaces
# weak-relevance edges; multi-step reasoning uses sub-question decomposition instead.
RETRIEVAL_GRAPH_TRAVERSAL_DEPTH=1
RETRIEVAL_GRAPH_MAX_NODES=50

# -----------------------------------------------------------------------------
# Evidence selection
# -----------------------------------------------------------------------------
# The number of retrieved candidates is not the number sent to the model.
EVIDENCE_MIN_ITEMS=1
EVIDENCE_MAX_ITEMS=8

# Measured cross-encoder scores are low and compressed: a relevant pair scored
# -10.58 against -11.24 for an irrelevant one. An absolute cutoff such as "keep
# scores above zero" would discard every candidate. Selection uses the margin
# relative to the top-ranked candidate instead. There is deliberately no
# absolute-threshold setting. Calibrated against the gold set.
EVIDENCE_RELATIVE_SCORE_MARGIN=0.35

# Diversity caps, so one verbose page cannot crowd out every other source.
EVIDENCE_MAX_CHILDREN_PER_PARENT=2
EVIDENCE_MAX_CHUNKS_PER_PAGE=3
EVIDENCE_MAX_CHUNKS_PER_DOCUMENT=4

# Generative compression can distort values and weaken citation alignment.
EVIDENCE_GENERATIVE_COMPRESSION_ENABLED=false
EVIDENCE_CONTEXT_TOKEN_BUDGET=6000

# Retrieval must terminate whether or not coverage was achieved.
MULTIHOP_MAX_ROUNDS=3
MULTIHOP_MAX_SUB_QUESTIONS=8
MULTIHOP_MAX_DOCUMENTS_PER_ROUND=6

# -----------------------------------------------------------------------------
# Memory
# -----------------------------------------------------------------------------
# Compaction runs when a threshold is crossed, never after every message.
MEMORY_COMPACTION_UNSUMMARIZED_MESSAGES=20
MEMORY_COMPACTION_UNSUMMARIZED_TOKENS=8000
MEMORY_COMPACTION_ACTIVE_CONTEXT_TOKENS=12000
MEMORY_COMPACTION_INACTIVITY_HOURS=24

# How much of each memory tier reaches the prompt. History lives in the database
# and is queried; it is not pasted in wholesale.
MEMORY_RECENT_RAW_TURNS=6
MEMORY_RETRIEVED_EPISODES=3
MEMORY_RETRIEVED_DURABLE_FACTS=8

# -----------------------------------------------------------------------------
# Background jobs
# -----------------------------------------------------------------------------
JOB_POLL_INTERVAL_SECONDS=2.0
JOB_BATCH_SIZE=1
JOB_LEASE_SECONDS=300                  # expired leases are reclaimable by another worker
JOB_HEARTBEAT_INTERVAL_SECONDS=30
JOB_MAX_ATTEMPTS=3                     # bounded retry, then dead-letter
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_MAX_SECONDS=900

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_ANSWER_TTL_SECONDS=86400
CACHE_RETRIEVAL_TTL_SECONDS=3600
CACHE_QUERY_REWRITE_TTL_SECONDS=86400
CACHE_OCR_TTL_SECONDS=2592000
CACHE_SWEEP_INTERVAL_SECONDS=3600
CACHE_PROMPT_VERSION=1                 # bump when a prompt template changes

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=console       # console | json

# Private documents, prompts and model outputs stay out of logs. Setting any of
# these true in production is rejected at startup.
OBSERVABILITY_LOG_PROMPTS=false
OBSERVABILITY_LOG_DOCUMENT_TEXT=false
OBSERVABILITY_LOG_MODEL_OUTPUTS=false
