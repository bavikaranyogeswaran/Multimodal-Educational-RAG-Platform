# Normalise line endings so a Windows dev machine and Linux deploy target agree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never diff or normalise.
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ico    binary
*.gguf   binary
*.onnx   binary
*.safetensors binary

# Lockfiles are generated; collapse them in diffs and reviews.
uv.lock            linguist-generated=true -diff
package-lock.json  linguist-generated=true -diff
